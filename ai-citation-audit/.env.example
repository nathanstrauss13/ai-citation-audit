# HoneyBaked Ham Citation Audit - API Configuration

# Perplexity API Configuration
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar-pro  # Optional: specify model version

# OpenAI (ChatGPT) API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini  # Optional: specify model version
OPENAI_ORGANIZATION=  # Optional: organization ID if applicable

# Anthropic (Claude) API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022  # Optional: specify model version

# Google Gemini API Configuration
GEMINI_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-flash  # Optional: specify model version

# Audit Configuration
DEBUG=False  # Enable detailed logging
LOG_LEVEL=INFO  # Logging verbosity (DEBUG, INFO, WARNING, ERROR)
MAX_RETRIES=3  # Number of API call retries
TIMEOUT=30  # API request timeout in seconds

# Output Configuration
OUTPUT_DIR=case_studies/honeybaked_ham/citation_audit  # Directory for audit results
GENERATE_HTML_REPORT=True  # Generate HTML summary report
GENERATE_CSV_REPORTS=True  # Generate detailed CSV reports

# Optional: Proxy Configuration (if needed)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080

# Optional: Rate Limiting
RATE_LIMIT_DELAY=1.0  # Delay between API calls (in seconds)

# Competitive Analysis
TRACK_COMPETITORS=True  # Enable competitor tracking
COMPETITOR_LIST=Omaha Steaks,Whole Foods,Costco,Harry & David,Williams Sonoma,Smithfield

# Experimental Features
ENABLE_CITATION_VERIFICATION=False  # Attempt to verify citation content
